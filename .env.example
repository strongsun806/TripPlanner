# 이 파일을 .env 로 복사하고 키를 넣는다. .env 는 커밋 · 제출하지 않는다 (NF3001)

# ── 외부 API (필수 Tool) ──
GEOAPIFY_KEY=
VISUALCROSSING_KEY=
KAKAO_REST_KEY=

# ── LLM (GMS) ──  2일차 라이브의 GMS_API_KEY 이름으로 넣어도 읽는다
GMS_KEY=
# GPT 토큰이 다 떨어져 Claude 를 쓴다 (주소에 anthropic 이 있으면 x-api-key 헤더를 자동으로 붙인다)
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.anthropic.com/v1
GMS_MODEL=claude-haiku-5-5
# 다시 GPT 로: GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1 , GMS_MODEL=gpt-5.4-nano
# 문서 검색 임베딩은 OpenAI 쪽만 있다 (실패하면 해시 벡터로 대체)
# GMS_EMBED_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1

# ── 실행 설정 (선택) ──
# AGENT_MODE=single          # single | planner_worker (심화 F3021)
# WORKER_LLM=1               # 0 이면 Worker 가 LLM 없이 실패를 그대로 보고 (비교 실험)
# LOGGING_ENABLED=1          # 0 이면 로깅 Agent 를 붙이지 않는다 (분리 확인용)
# CALENDAR_BACKEND=local     # local | google (심화 F3023, credentials.json 필요)
# RAG_DB_DIR=                # 2회차 TripPilot 의 chroma_db 폴더를 가리키면 그대로 검색 (심화 F3022)
